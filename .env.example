# Copie para .env (nunca commite chaves reais). No deploy, configure as
# Environment Variables no painel do Render/Vercel em vez deste arquivo.
GOOGLE_PLACES_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
JWT_SECRET=troque-por-uma-string-aleatoria-de-32-chars-min
DB_CONN=Host=localhost;Port=5432;Database=guia;Username=guia;Password=guia

POSTGRES_DB=guia
POSTGRES_USER=guia
POSTGRES_PASSWORD=guia
POSTGRES_PORT=5432
API_PORT=8080
# Só o front chama a API (aceita lista separada por vírgula). No Render:
# CORS_ORIGINS=https://SEU-APP.vercel.app
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080

# Demo local sem Docker: DB_PROVIDER=sqlite usa arquivo local (sem Postgres).
#DB_PROVIDER=sqlite
#DB_CONN=DataSource=guia_demo.db

# Deploy (Neon): troque DB_CONN pela connection string do Neon, ex.:
# DB_CONN=Host=ep-xxxx.us-east-2.aws.neon.tech;Port=5432;Database=guia;Username=seu-user;Password=sua-senha;Ssl Mode=Require;Trust Server Certificate=true
